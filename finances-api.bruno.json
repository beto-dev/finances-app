            "body": {
              "mode": "raw",
              "raw": "{\n  \"pattern\": \"UBER\",\n  \"exclude_charge_id\": \"{{chargeId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/charges/share-similar", "host": ["{{baseUrl}}"], "path": ["api", "charges", "share-similar"] }
          }
