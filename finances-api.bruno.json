    {
      "name": "Statements",
      "item": [
        {
          "name": "List Statements",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/statements/", "host": ["{{baseUrl}}"], "path": ["api", "statements", ""] }
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/statements/summary", "host": ["{{baseUrl}}"], "path": ["api", "statements", "summary"] }
          }
        },
        {
          "name": "Upload Statement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "statement_type", "value": "checking", "type": "text", "description": "checking | credit_card | credit_line | manual" },
                { "key": "bank_hint", "value": "santander", "type": "text", "description": "Optional. One of 21 Chilean banks or 'manual'" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/statements/", "host": ["{{baseUrl}}"], "path": ["api", "statements", ""] }
          }
        },
        {
          "name": "Update Statement Type",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "statement_type", "value": "credit_card", "type": "text", "description": "checking | credit_card | credit_line | manual" },
                { "key": "bank_hint", "value": "falabella", "type": "text", "description": "Optional" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/statements/{{statementId}}", "host": ["{{baseUrl}}"], "path": ["api", "statements", "{{statementId}}"] }
          }
        },
        {
          "name": "Delete Statement",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/statements/{{statementId}}", "host": ["{{baseUrl}}"], "path": ["api", "statements", "{{statementId}}"] }
          }
        },
